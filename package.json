{
  "name": "opencloset-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-query": "^5.95.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.488.0",
    "msw": "^2.10.2",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.0.0",
    "react-datepicker": "^8.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-kakao-login": "^2.1.1",
    "react-router-dom": "^7.5.0",
    "swiper": "^12.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.1",
    "@eslint/js": "^9.21.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tsconfig/vite-react": "^7.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.75.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npx prettier --write"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "msw@2.12.13": true,
    "workerd@1.20260317.1": true
  }
}
